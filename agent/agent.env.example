# nach /etc/dockposer-agent.env kopieren, chmod 600
DOCKPOSER_TOKEN=hier-das-token-aus-der-registrierung
DOCKPOSER_STACKS=/home/docker-user/stacks
# Adresse, unter der der Core den Agent erreicht (nicht 127.0.0.1 bei Remote-Zugriff!)
DOCKPOSER_LISTEN=127.0.0.1:8720
# Welche Konfigdateien im Stack-Ordner bearbeitbar sind (Globs erlaubt)
DOCKPOSER_EDITABLE_FILES=.env
