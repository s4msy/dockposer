ORIGIN=https://dockposer.example.com
SESSION_SECRET=        # openssl rand -hex 32
ENCRYPTION_KEY=        # openssl rand -hex 32  (AES-256-GCM für TOTP- und Agent-Secrets)

# Lokaler Agent (das System, auf dem Dockposer selbst läuft)
STACKS_PATH=/home/user/stacks
# Bearbeitbare Konfigdateien im lokalen Agent, z. B. ".env,Caddyfile"
EDITABLE_FILES=.env

LOCAL_AGENT_TOKEN=     # openssl rand -hex 32 — bei der Server-Registrierung in der UI eintragen

# DATABASE_PATH=/app/data/dockposer.db   (Default, nur bei Bedarf ändern)
